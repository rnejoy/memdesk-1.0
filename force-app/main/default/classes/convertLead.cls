public class convertLead {

	public static void processLeadConversion(Map<Id, Lead> newLeadMap, Map<Id, Lead> oldLeadMap) {
		System.Debug('we are in converLead!');
		for (Lead ld : newLeadMap.values()) {
			if (newLeadMap.get(ld.Id).Convert_Lead_Now__c && !oldLeadMap.get(ld.Id).Convert_Lead_Now__c) {
				Database.LeadConvert lc = new database.LeadConvert();
					if (newLeadMap.get(ld.Id).Customer_Sub_Type__c == 'Extension') {
						lc.setAccountId(newLeadMap.get(ld.Id).Account_Id__c);
					}
					lc.setLeadId(ld.Id);
					lc.setDoNotCreateOpportunity(true);
				LeadStatus convertStatus = [SELECT Id, MasterLabel FROM LeadStatus WHERE IsConverted=true LIMIT 1];
					lc.setConvertedStatus(convertStatus.MasterLabel);
					Database.LeadConvertResult lcr = Database.convertLead(lc);

				//i have been commenting this out and back again.. we really have to do this here because we have to read the
				//	Lead record again.. the ConvertedContactId will ONLY have a VALUE AFTER the above CONVERSION
				Lead ldo = [SELECT Id,
								   Barangay_Code__c,
								   Campaign_Id__c,
								   Campaign_Promo_Id__c,
								   ConvertedContactId,
								   Customer_Sub_Type__c,
								   Primary_Expiry_Date__c,
								   Store_Signup_Code__c,
								   Is_Generated__c,
								   Expected_Start_Date__c,
								   Expected_Expiry_Date__c
								FROM Lead WHERE Id =: ld.Id];
				//if the lead record was registered to a registration campaign then there is a chance we need to update the
				//	the Status to Converted
				if (ldo.Campaign_Id__c != null) {
					List<CampaignMember> cmem = [SELECT Id, CampaignId FROM CampaignMember
											WHERE CampaignId =: ldo.Campaign_Id__c AND LeadId =: ld.Id];
					if (cmem.size() > 0) {
						System.Debug('CampaignId :>> ' + cmem[0].CampaignId);
						cmem[0].Status = 'Converted';
					}
					update cmem;
				}

				Store__c stor = [SELECT Distance_Index__c, IsPreOpening__c, Name, SpecialExpiryDate__c FROM Store__c WHERE Code__c =: ldo.Store_Signup_Code__c];
				Barangay__c brng = [SELECT Id, Zip_Code__c,
										Distance_0__c,
										Distance_1__c,
										Distance_2__c,
										Distance_3__c,
										Distance_4__c,
										Distance_5__c
									FROM Barangay__c
									WHERE Code__c =: ldo.Barangay_Code__c];
				List<Decimal> distances = new List<Decimal>();
				distances.add(brng.Distance_0__c);
				distances.add(brng.Distance_1__c);
				distances.add(brng.Distance_2__c);
				distances.add(brng.Distance_3__c);
				distances.add(brng.Distance_4__c);
				distances.add(brng.Distance_5__c);

				Contact con = [SELECT Id FROM Contact WHERE Id =: ldo.ConvertedContactId];
				con.Zip_Code__c = brng.Zip_Code__c;
				con.Distance__c = distances[integer.valueof(stor.Distance_Index__c)];
				//with the new Generated lead, we now have two possible Start dates
				System.Debug('ldo.Is_Generated__c :>> ' + ldo.Is_Generated__c);
				System.Debug('ldo.Expected_Start_Date__c :>> ' + ldo.Expected_Start_Date__c);
				System.Debug('lod.Expected_Expiry_Date__c :>> ' + ldo.Expected_Expiry_Date__c);
				if (ldo.Is_Generated__c == true)
					con.Membership_Start_Date__c = Date.valueOf(ldo.Expected_Start_Date__c);
				else
					con.Membership_Start_Date__c = Date.Today();

				//this is a late request -- Pre-opening stores have a different way of getting expiry date --
				//	it is not calculated but a fixed date usually based on the expected opening date of the store
				//	so... here goes
				if (stor.IsPreOpening__c == true) {
					//true for both Primary and Extention
					if (ldo.Is_Generated__c == true)
						con.Membership_Expiry_Date__c = Date.valueOf(ldo.Expected_Expiry_Date__c);
					else
						con.Membership_Expiry_Date__c = Date.valueOf(stor.SpecialExpiryDate__c);
				}
				else {
					//we moved the filling of both the membership start and expiry dates here from workflows/field update
					//	because Extension expiry date needs to be calculated.. see comments below for expiry date rule
					//if (newLeadMap.get(ld.Id).Customer_Sub_Type__c == 'Primary') {
					if (ldo.Customer_Sub_Type__c == 'Primary') {
						if (ldo.Is_Generated__c == true)
							con.Membership_Expiry_Date__c = Date.valueOf(ldo.Expected_Expiry_Date__c);
						else
							con.Membership_Expiry_Date__c = Date.Today().addYears(1);
					}
					else {
						//FOR EXTENSIONS -- we convert expiry date to milliseconds so we can have an accurate comparison later
						//Date expdate = Date.valueOf(newLeadMap.get(ld.Id).Primary_Expiry_Date__c);
						Date expdate = Date.valueOf(ldo.Primary_Expiry_Date__c);
						Integer dy = expdate.day();
						Integer mo = expdate.month();
						Integer yr = expdate.year();
						Datetime dt = Datetime.newInstance(yr, mo, dy);
						Long expmilli = dt.getTime();
						//we get date 1 year from today and convert it to milliseconds to compare mamaya
						Date sysdate = Date.Today().addYears(1);
						dy = sysdate.day();
						mo = sysdate.month();
						yr = sysdate.year();
						dt = Datetime.newInstance(yr, mo, dy);
						Long sysmilli = dt.getTime();
						System.Debug('expmilli :>> ' + expmilli);
						System.Debug('sysmilli :>> ' + sysmilli);
						//we compare the two millisecond conversions
						if (expmilli > sysmilli)
							//if expiry date of primary is longer than 1 year.. we give the extension one year to expire
							con.Membership_Expiry_Date__c = sysdate;
						else
							//but if expiry date of primary is equal to or less than one year, we pass that expiry date to extension
							con.Membership_Expiry_Date__c = expdate;
					}
				}

				update con;

				//we enroll the member in the Promo campaign after conversion
				System.Debug('ldo.ConvertedContactId :>> '   + ldo.ConvertedContactId);
				System.Debug('ldo.Campaign_Promo_Id__c :>> ' + ldo.Campaign_Promo_Id__c);
				if (ldo.Campaign_Promo_Id__c != null) {
					CampaignMember cmemb = new CampaignMember();
					cmemb.CampaignId = ldo.Campaign_Promo_Id__c;
					cmemb.ContactId  = ldo.ConvertedContactId;
					insert cmemb;
					System.Debug('cmemb.Id :>> ' + cmemb.Id);
				}
			}
		}
	}

